<?xml version="1.0" encoding="utf-8"?>
<Talents>
    <Talent identifier="MokouTalent">
        <Icon texture="%ModDir%/Images/Talents/MokouTalent.png" sheetindex="0,0" sheetelementsize="128,128"/>
        <Description tag="talentdescription.MokouTalent"/>
        <AbilityGroupInterval Interval="5.0">
            <Conditions>
                <AbilityConditionHasAffliction afflictionidentifier="Touhou_Mokou_Character_Effect"/>
            </Conditions>
            <Abilities>
                <CharacterAbilityModifyResistance resistanceid="Phoenix_Burn" multiplier="0.5"/>
            </Abilities>
        </AbilityGroupInterval>
        <AbilityGroupEffect abilityeffecttype="None">
            <Conditions>
                <AbilityConditionHasAffliction afflictionidentifier="No_Effects10"/>
            </Conditions>
            <Abilities>
                <CharacterAbilityGiveResistance resistanceid="Resurrection" multiplier="0"/>
            </Abilities>
        </AbilityGroupEffect>

        <AbilityGroupInterval interval="60">
            <Conditions>
                <AbilityConditionHasAffliction afflictionidentifier="Touhou_Mokou_Character_Effect"/>
            </Conditions>
            <Abilities>
                <CharacterAbilityApplyStatusEffects>
                    <StatusEffects>
                        <StatusEffect target="Character" multiplyafflictionsbymaxvitality="true">
                            <Affliction identifier="Mokou_Not_Die" strength="60"/>
                        </StatusEffect>
                    </StatusEffects>
                </CharacterAbilityApplyStatusEffects>
            </Abilities>
        </AbilityGroupInterval>

        <AbilityGroupInterval maxtriggercount="1">
            <Conditions>
                <AbilityConditionHasAffliction afflictionidentifier="Touhou_Mokou_Character_Effect"/>
                <AbilityConditionAboveVitality invert="true" vitalitypercentage="0"/>
                <AbilityConditionHasPermanentStat statidentifier="Mokou_Resurrection" min="1" invert="true"/>
            </Conditions>
            <Abilities>
                <CharacterAbilityApplyStatusEffects>
                    <StatusEffects>
                        <StatusEffect type="OnAbility" target="Character" multiplyafflictionsbymaxvitality="true" disabledeltatime="true">
                            <Affliction identifier="Resurrection" amount="30"/>
                        </StatusEffect>
                    </StatusEffects>
                </CharacterAbilityApplyStatusEffects>
                <CharacterAbilityApplyStatusEffectsToAllies allowself="false">
                    <StatusEffects>
                        <StatusEffect type="OnAbility" target="Character">
                            <Affliction identifier="No_Effects10" strength="1"/>
                        </StatusEffect>
                    </StatusEffects>
                </CharacterAbilityApplyStatusEffectsToAllies>
                <CharacterAbilityGivePermanentStat statidentifier="Mokou_Resurrection" value="1"/>
            </Abilities>
        </AbilityGroupInterval>

        <AbilityGroupInterval Interval="4.9">
            <Conditions>
                <AbilityConditionHasAffliction afflictionidentifier="Touhou_Mokou_Character_Effect"/>
                <AbilityConditionHasPermanentStat statidentifier="Mokou_Resurrection" min="1" invert="true"/>
            </Conditions>
            <Abilities>
                <CharacterAbilityModifyStat stattype="RangedAttackMultiplier" value="0.1"/>
                <CharacterAbilityModifyStat stattype="MeleeAttackMultiplier" value="0.1"/>
            </Abilities>
        </AbilityGroupInterval>

        <AbilityGroupInterval Interval="4.9">
            <Conditions>
                <AbilityConditionHasAffliction afflictionidentifier="Touhou_Mokou_Character_Effect"/>
                <AbilityConditionHasPermanentStat statidentifier="Mokou_Resurrection" min="1" />
            </Conditions>
            <Abilities>
                <CharacterAbilityModifyStat stattype="RangedAttackMultiplier" value="-0.1"/>
                <CharacterAbilityModifyStat stattype="MeleeAttackMultiplier" value="-0.1"/>
                <CharacterAbilityModifyStat stattype="MaximumHealthMultiplier" value="0.1"/>
            </Abilities>
        </AbilityGroupInterval>

        <AbilityGroupEffect abilityeffecttype="OnRoundEnd">
            <Abilities>
                <CharacterAbilityResetPermanentStat statidentifier="Mokou_Resurrection"/>
            </Abilities>
        </AbilityGroupEffect>

        <AbilityGroupEffect abilityeffecttype="OnAttack">
            <Conditions>
                <AbilityConditionHasAffliction afflictionidentifier="Touhou_Mokou_Character_Effect"/>
                <AbilityConditionAttackData tags="Touhou_Magic_Danmu" ignorenonharmfulattacks="true" weapontype="HandheldRanged"/>
                <AbilityConditionCharacter targettype="Enemy">
                    <Conditional burn="gt 5"/>
                </AbilityConditionCharacter>
            </Conditions>
            <Abilities>
                <CharacterAbilityGiveAffliction affliction="Mokou_Talent_Effect" strength="10"/>
            </Abilities>
        </AbilityGroupEffect>

        <AbilityGroupEffect abilityeffecttype="OnAddDamageAffliction">
            <Conditions>
                <AbilityConditionHasAffliction afflictionidentifier="Touhou_Mokou_Character_Effect"/>
            </Conditions>
            <Abilities>
                <CharacterAbilityModifyAffliction afflictionidentifiers="Phoenix_Burn" addedmultiplier="0.3"/>
                <CharacterAbilityModifyAffliction afflictionidentifiers="burn" addedmultiplier="0.1"/>
            </Abilities>
        </AbilityGroupEffect>

    </Talent>
</Talents>